DB_ADMIN=postgresql://postgres:123@localhost/bookcrossing_db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ЛР3: используются только при локальном запуске без Docker — внутри
# docker-compose эти же переменные задаются в docker-compose.yml и
# указывают на контейнеры parser/redis, а не на localhost.
PARSER_SERVICE_URL=http://localhost:8001
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
